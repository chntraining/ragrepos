# Bodhi — Agentic RAG Studio by Dinesh AI Academy
# Copy this file to .env (inside the project folder) and fill in real values. Never commit .env.
# Only placeholders belong in this file. Every other setting and its default is listed in docs/SPEC.md (Config).

# --- Profile: local | demo | production -------------------------------------
APP_PROFILE=local
# Bind address. AUTH_MODE=none is refused unless HOST is 127.0.0.1 / localhost.
HOST=127.0.0.1
DEBUG=false

# --- Security ---------------------------------------------------------------
# AUTH_MODE=none is only allowed in the local profile on 127.0.0.1.
AUTH_MODE=jwt
# Secure cookie flag: keep true everywhere except plain-http local development.
COOKIE_SECURE=false
# Long random string (e.g. 64+ chars). Required in production.
JWT_SECRET=change-me
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:4200
# First admin account, created on first start if no users exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Database (SQLite by default; Postgres by changing the URL) --------------
DATABASE_URL=sqlite:///./data/bodhi.db
# DATABASE_URL=postgresql+psycopg://bodhi:password@localhost:5432/bodhi

# --- Vector store (ChromaDB) --------------------------------------------------
VECTOR_STORE=chroma
CHROMA_MODE=embedded
CHROMA_PATH=./data/chroma
# CHROMA_MODE=server
# CHROMA_HOST=localhost
# CHROMA_PORT=8001

# --- LLM providers (a provider appears in the model picker only when its key is set) ---
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_PROVIDER=google_genai
DEFAULT_LLM_MODEL=gemini-3.5-flash-lite
# Offline "Simulated model" for tests, E2E and demo fallback. Refused in production.
ENABLE_FAKE_PROVIDER=true

# --- Embeddings (changing these requires a re-index) --------------------------
EMBEDDING_PROVIDER=google_genai
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
